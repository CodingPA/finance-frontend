From bbdf9d6fc1da1956932e25386e37d2a925852e59 Mon Sep 17 00:00:00 2001
From: deployer <deployer@ip-172-31-46-220.ec2.internal>
Date: Thu, 13 Aug 2026 16:26:13 +0000
Subject: [PATCH] Update nginx config and build info

---
 deploy/nginx.conf    | 27 ++++++++++++++++++++++++---
 tsconfig.tsbuildinfo |  2 +-
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/deploy/nginx.conf b/deploy/nginx.conf
index 43a5c49..d902c44 100644
--- a/deploy/nginx.conf
+++ b/deploy/nginx.conf
@@ -15,13 +15,11 @@
 # lines are hand-written here.
 
 server {
-    listen 80;
-    listen [::]:80;
     server_name finance.codingpa.com;
 
     # Deploy user's home directory -- adjust if the deploy user's name or
     # clone location ever changes.
-    root /home/deploy/finance-frontend/dist;
+    root /home/deployer/finance-frontend/dist;
     index index.html;
 
     location /api/ {
@@ -57,4 +55,27 @@ server {
     location / {
         try_files $uri /index.html;
     }
+
+    listen [::]:443 ssl; # managed by Certbot
+    listen 443 ssl; # managed by Certbot
+    ssl_certificate /etc/letsencrypt/live/finance.codingpa.com/fullchain.pem; # managed by Certbot
+    ssl_certificate_key /etc/letsencrypt/live/finance.codingpa.com/privkey.pem; # managed by Certbot
+    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
+    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
+
 }
+
+
+server {
+    if ($host = finance.codingpa.com) {
+        return 301 https://$host$request_uri;
+    } # managed by Certbot
+
+
+    listen 80;
+    listen [::]:80;
+    server_name finance.codingpa.com;
+    return 404; # managed by Certbot
+
+
+}
\ No newline at end of file
