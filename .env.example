# Copy to .env.local for local dev. Vite only exposes vars prefixed VITE_.
# Note these are inlined at build time, not read at runtime -- changing either
# one means rebuilding, and in Docker they're build args, not `environment:`.

# Left as /api on purpose: the dev server proxies /api -> http://localhost:8001
# (see vite.config.ts), so relative paths work without CORS setup. In Docker,
# nginx does the same proxying -- set BACKEND_URL on the container instead of
# touching this.
VITE_API_BASE_URL=/api

# From Google Cloud Console (APIs & Services -> Credentials -> OAuth client ID
# -> Web application). Must match GOOGLE_OAUTH_CLIENT_ID on the backend.
# Leave blank to disable the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
