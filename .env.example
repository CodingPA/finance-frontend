# Copy to .env.local for local dev. Vite only exposes vars prefixed VITE_.

# Left as /api on purpose: the dev server proxies /api -> http://localhost:8000
# (see vite.config.ts), so relative paths work without CORS setup.
VITE_API_BASE_URL=/api

# From Google Cloud Console (APIs & Services -> Credentials -> OAuth client ID
# -> Web application). Must match GOOGLE_OAUTH_CLIENT_ID on the backend.
# Leave blank to disable the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
